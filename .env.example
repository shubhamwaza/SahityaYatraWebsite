# SahityaYatra — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.

# ── Site ──────────────────────────────────────────────────────────────────
# Full URL of the production site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Shopify (add after approval and Shopify store setup) ─────────────────
# Storefront API public access token (safe for browser)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_public_token_here

# Shopify store domain (e.g. your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Storefront API version
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01

# Admin API token — SERVER SIDE ONLY, never expose to browser
SHOPIFY_ADMIN_TOKEN=your_admin_token_here

# ── Analytics (add after privacy review and approval) ────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# ── Contact form (add when contact form integration is chosen) ────────────
# CONTACT_FORM_DESTINATION=your_destination_here
